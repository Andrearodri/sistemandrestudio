      "parameters": {
        "jsCode": "const secret = $env.TELEGRAM_WEBHOOK_SECRET;\nconst received = $json.headers?.['x-telegram-bot-api-secret-token'];\nif (!secret || received !== secret) throw new Error('TELEGRAM_WEBHOOK_ORIGIN_INVALID');\nconst callback = $json.body?.callback_query;\nif (!callback || typeof callback.data !== 'string') throw new Error('TELEGRAM_CALLBACK_INVALID');\nreturn [{json:{callbackData:callback.data,chatId:String(callback.message?.chat?.id ?? ''),userId:String(callback.from?.id ?? ''),receivedAt:new Date().toISOString(),externalMessageReference:`telegram-update:${String($json.body?.update_id ?? '')}`}}];"
      },
