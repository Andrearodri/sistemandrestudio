{
  "name": "sistemandrestudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts packages/sources/test/*.test.ts packages/evidence/test/*.test.ts",
    "test:relevance": "node --test tests/relevance-policy.test.ts",
    "test:application": "node --test packages/application/test/editorial-workflow-service.test.ts packages/application/test/official-source-radar-service.test.ts",
    "test:application:integration": "node --env-file-if-exists=.env.test --test --test-concurrency=1 packages/application/test/*.postgres.test.ts",
    "test:watch": "node --test --watch tests/editorial-state-machine.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --test packages/database/test/postgres-editorial-news-repository.test.ts",
    "demo": "node apps/sistemandrestudio-api/src/demo.ts",
    "demo:application": "node apps/sistemandrestudio-api/src/demo-application.ts",
    "demo:application:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-application-postgres.ts",
    "demo:relevance": "node apps/sistemandrestudio-api/src/demo-relevance.ts",
    "demo:relevance:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-relevance-postgres.ts",
    "demo:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-postgres.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:status": "node --env-file-if-exists=.env.local packages/database/src/cli.ts status",
    "db:migrate": "node --env-file-if-exists=.env.local packages/database/src/cli.ts migrate",
    "db:migrate:test": "node --env-file-if-exists=.env.test packages/database/src/cli.ts migrate",
    "db:reset:test": "node --env-file-if-exists=.env.test packages/database/src/cli.ts reset-test",
    "radar:fixtures": "node --test packages/sources/test/sources.test.ts",
    "radar:validate": "node --env-file-if-exists=.env.test apps/sistemandrestudio-api/src/radar-validate.ts",
    "radar:official": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/radar-official.ts",
    "demo:verification": "node apps/sistemandrestudio-api/src/demo-verification.ts",
    "demo:verification:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-verification-postgres.ts",
    "verify:official": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/verify-official.ts",
    "demo:evidence": "node apps/sistemandrestudio-api/src/demo-evidence.ts",
    "demo:evidence:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-evidence-postgres.ts",
    "evidence:official": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/evidence-official.ts",
    "evidence:diagnose": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/evidence-diagnose.ts",
    "demo:draft": "node apps/sistemandrestudio-api/src/demo-draft.ts",
    "draft:official": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/draft-official.ts",
    "demo:draft:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-draft-postgres.ts",
    "pipeline:official:draft": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/pipeline-official-draft.ts",
    "review:list": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-list.ts",
    "review:official": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-official.ts",
    "review:show": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-show.ts",
    "review:approve": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-action.ts approve",
    "review:request-changes": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-action.ts request-changes",
    "review:reject": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-action.ts reject",
    "review:revise": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/review-action.ts revise"
    ,"demo:review": "node apps/sistemandrestudio-api/src/demo-review.ts"
    ,"demo:review:postgres": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/demo-review-postgres.ts",
    "publication:list-eligible": "node --env-file-if-exists=.env.local apps/sistemandrestudio-api/src/publication-cli.ts list-eligible",
